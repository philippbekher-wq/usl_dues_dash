# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Airtable Personal Access Token (create at https://airtable.com/create/tokens)
# Needs read scope (data.records:read) on the base below.
AIRTABLE_PAT=

# The Airtable base ID (starts with "app...", found in the base's API docs or URL)
AIRTABLE_BASE_ID=

# Supabase project URL and anon (public) key — used for staff login.
# Find both in Supabase dashboard → Project Settings → API.
# Only the anon key belongs here — never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
